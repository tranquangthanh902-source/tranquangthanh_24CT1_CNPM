<%- include('../partials/header') %>

<div class="container-fluid py-4">
  <!-- Header -->
  <div class="row mb-4">
	<div class="col-12">
	  <div class="d-flex justify-content-between align-items-center">
		<div>
		  <h1 class="mb-1"><i class="bi bi-people-fill"></i> Quản lý tài khoản</h1>
		  <p class="text-muted">Quản lý và giám sát các tài khoản người dùng hệ thống</p>
		</div>
		<div class="text-end">
		  <div class="stat-badge">
			<div class="stat-number"><%= users ? users.length : 0 %></div>
			<div class="stat-label">Tài khoản</div>
		  </div>
		</div>
	  </div>
	</div>
  </div>

  <%- include('../partials/flash') %>

  <% if(users && users.length > 0) { %>
	<!-- Stats Cards -->
	<div class="row mb-3">
	  <div class="col-md-3">
		<div class="card stat-card shadow-sm border-0">
		  <div class="card-body">
			<div class="d-flex align-items-center">
			  <div class="stat-icon bg-danger-soft">
				<i class="bi bi-shield-check text-danger"></i>
			  </div>
			  <div class="ms-3">
				<div class="stat-value"><%= users.filter(u => u.role === 'admin').length %></div>
				<div class="stat-text">Admin</div>
			  </div>
			</div>
		  </div>
		</div>
	  </div>
	  <div class="col-md-3">
		<div class="card stat-card shadow-sm border-0">
		  <div class="card-body">
			<div class="d-flex align-items-center">
			  <div class="stat-icon bg-info-soft">
				<i class="bi bi-person text-info"></i>
			  </div>
			  <div class="ms-3">
				<div class="stat-value"><%= users.filter(u => u.role === 'user').length %></div>
				<div class="stat-text">User</div>
			  </div>
			</div>
		  </div>
		</div>
	  </div>
	</div>

	<!-- Table -->
	<div class="card shadow-sm border-0">
	  <div class="card-body p-0">
		<div class="table-responsive">
		  <table class="table table-hover mb-0">
			<thead class="table-light border-bottom">
			  <tr>
				<th class="ps-4">Tên đăng nhập</th>
				<th>Tên đầy đủ</th>
				<th>Email</th>
				<th>Vai trò</th>
				<th>Ngày đăng ký</th>
				<th class="text-center">Hành động</th>
			  </tr>
			</thead>
			<tbody>
			  <% users.forEach(user => { %>
				<tr class="align-middle">
				  <td class="ps-4">
					<div class="user-badge">
					  <i class="bi bi-person-circle"></i>
					  <strong><%= user.username %></strong>
					</div>
				  </td>
				  <td><%= user.full_name %></td>
				  <td>
					<small class="text-muted"><%= user.email || '—' %></small>
				  </td>
				  <td>
					<% if(user.role === 'admin') { %>
					  <span class="badge bg-danger"><i class="bi bi-shield-check"></i> Admin</span>
					<% } else { %>
					  <span class="badge bg-secondary"><i class="bi bi-person"></i> User</span>
					<% } %>
				  </td>
				  <td>
					<small class="text-muted"><%= user.created_at_display %></small>
				  </td>
				  <td class="text-center">
					<div class="btn-group btn-group-sm" role="group">
					  <a href="/admin/users/edit/<%= user.id %>" class="btn btn-sm btn-outline-primary" title="Chỉnh sửa">
						<i class="bi bi-pencil"></i>
					  </a>
					  <% if(currentUser.id !== user.id) { %>
						<button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteModal<%= user.id %>" title="Xóa">
						  <i class="bi bi-trash"></i>
						</button>
					  <% } else { %>
						<button type="button" class="btn btn-sm btn-outline-danger" disabled title="Không thể xóa chính mình">
						  <i class="bi bi-trash"></i>
						</button>
					  <% } %>
					</div>
				  </td>
				</tr>

				<!-- Delete Modal -->
				<% if(currentUser.id !== user.id) { %>
				  <div class="modal fade" id="deleteModal<%= user.id %>" tabindex="-1">
					<div class="modal-dialog modal-dialog-centered">
					  <div class="modal-content border-0 shadow">
						<div class="modal-header bg-light border-bottom">
						  <h5 class="modal-title"><i class="bi bi-exclamation-triangle text-danger"></i> Xác nhận xóa</h5>
						  <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
						</div>
						<div class="modal-body">
						  Bạn có chắc chắn muốn xóa tài khoản <strong><%= user.username %></strong>? 
						  <div class="alert alert-warning mt-3 mb-0">
							<small><i class="bi bi-info-circle"></i> Hành động này không thể hoàn tác.</small>
						  </div>
						</div>
						<div class="modal-footer bg-light">
						  <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
						  <form method="POST" action="/admin/users/delete/<%= user.id %>" style="display:inline;">
							<button type="submit" class="btn btn-danger">
							  <i class="bi bi-trash"></i> Xóa
							</button>
						  </form>
						</div>
					  </div>
					</div>
				  </div>
				<% } %>
			  <% }); %>
			</tbody>
		  </table>
		</div>
	  </div>
	</div>
  <% } else { %>
	<div class="card border-0 shadow-sm">
	  <div class="card-body text-center py-5">
		<i class="bi bi-inbox display-1 text-muted"></i>
		<h5 class="mt-3 text-muted">Hiện không có tài khoản nào</h5>
		<p class="text-muted">Các tài khoản sẽ xuất hiện tại đây khi người dùng đăng ký.</p>
	  </div>
	</div>
  <% } %>
</div>

<style>
  .stat-badge {
	background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
	color: white;
	padding: 20px 30px;
	border-radius: 10px;
	text-align: center;
	min-width: 120px;
  }
  .stat-number {
	font-size: 32px;
	font-weight: bold;
  }
  .stat-label {
	font-size: 12px;
	opacity: 0.9;
	text-transform: uppercase;
	letter-spacing: 1px;
  }
  .stat-card {
	border-radius: 10px;
	transition: transform 0.2s;
  }
  .stat-card:hover {
	transform: translateY(-3px);
  }
  .stat-icon {
	width: 50px;
	height: 50px;
	border-radius: 10px;
	display: flex;
	align-items: center;
	justify-content: center;
	font-size: 24px;
  }
  .bg-danger-soft {
	background-color: rgba(220, 53, 69, 0.1);
  }
  .bg-info-soft {
	background-color: rgba(23, 162, 184, 0.1);
  }
  .stat-value {
	font-size: 24px;
	font-weight: bold;
	color: #333;
  }
  .stat-text {
	color: #666;
	font-size: 12px;
	text-transform: uppercase;
	letter-spacing: 0.5px;
  }
  .user-badge {
	display: flex;
	align-items: center;
	gap: 8px;
	font-weight: 500;
  }
  .user-badge i {
	font-size: 18px;
	color: #667eea;
  }
  .btn-outline-primary:hover {
	background-color: #667eea;
	border-color: #667eea;
	color: white;
  }
  .btn-outline-danger:hover {
	background-color: #dc3545;
	border-color: #dc3545;
	color: white;
  }
  .table thead th {
	font-weight: 600;
	color: #333;
	font-size: 13px;
	text-transform: uppercase;
	letter-spacing: 0.5px;
  }
  .card {
	border-radius: 10px;
  }
</style>

<%- include('../partials/footer') %>
