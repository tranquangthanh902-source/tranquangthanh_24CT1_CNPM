<%- include('../partials/header') %>

<div class="admin-main">
  <!-- Topbar -->
  <div class="topbar">
	<div>
	  <p class="muted">Thư viện</p>
	  <h1>Quản lý tài khoản</h1>
	</div>
	<div class="user">
	  <i class="bi bi-person-circle" style="margin-right: 8px;"></i>
	  <%= currentUser?.full_name || 'Admin' %>
	</div>
  </div>

  <!-- Filters/Tabs -->
  <div style="display: flex; gap: 12px; margin-bottom: 20px; border-bottom: 2px solid #edf0f1; padding-bottom: 0;">
	<a href="#" style="padding: 15px 20px; background: none; border: none; font-weight: 600; color: #122c35; border-bottom: 3px solid #2d9f70; margin-bottom: -2px; cursor: pointer;">
	  <i class="bi bi-people-fill" style="margin-right: 8px;"></i>Tất cả (<%= users ? users.length : 0 %>)
	</a>
	<a href="#" style="padding: 15px 20px; background: none; border: none; font-weight: 600; color: #70818a; margin-bottom: -2px; cursor: pointer;">
	  <i class="bi bi-shield-check" style="margin-right: 8px;"></i>Admin (<%= users ? users.filter(u => u.role === 'admin').length : 0 %>)
	</a>
	<a href="#" style="padding: 15px 20px; background: none; border: none; font-weight: 600; color: #70818a; margin-bottom: -2px; cursor: pointer;">
	  <i class="bi bi-person" style="margin-right: 8px;"></i>User (<%= users ? users.filter(u => u.role === 'user').length : 0 %>)
	</a>
  </div>

  <%- include('../partials/flash') %>

  <% if(users && users.length > 0) { %>
	<!-- Main Panel -->
	<div class="panel">
	  <div class="table-responsive">
		<table>
		  <thead>
			<tr>
			  <th>Tên đăng nhập</th>
			  <th>Tên đầy đủ</th>
			  <th>Email</th>
			  <th>Vai trò</th>
			  <th>Ngày đăng ký</th>
			  <th style="text-align: center;">Hành động</th>
			</tr>
		  </thead>
		  <tbody>
			<% users.forEach(user => { %>
			  <tr>
				<td>
				  <strong><%= user.username %></strong>
				</td>
				<td><%= user.full_name %></td>
				<td style="color: #70818a; font-size: 13px;">
				  <%= user.email || '—' %>
				</td>
				<td>
				  <% if(user.role === 'admin') { %>
					<span class="badge" style="background: #fff1ce; color: #9a6b00;">
					  <i class="bi bi-shield-check" style="margin-right: 4px;"></i>Admin
					</span>
				  <% } else { %>
					<span class="badge" style="background: #e4f6ec; color: #18834f;">
					  <i class="bi bi-person" style="margin-right: 4px;"></i>User
					</span>
				  <% } %>
				</td>
				<td style="color: #70818a; font-size: 13px;">
				  <%= user.created_at_display %>
				</td>
				<td style="text-align: center;">
				  <div class="actions-cell">
					<a href="/admin/users/edit/<%= user.id %>" title="Chỉnh sửa">
					  <i class="bi bi-pencil"></i>
					</a>
					<% if(currentUser.id !== user.id) { %>
					  <button type="button" title="Xóa" data-bs-toggle="modal" data-bs-target="#deleteModal<%= user.id %>" style="border: none; background: none; cursor: pointer;">
						<i class="bi bi-trash"></i>
					  </button>
					<% } else { %>
					  <button type="button" disabled title="Không thể xóa chính mình" style="border: none; background: none; cursor: not-allowed; opacity: 0.3;">
						<i class="bi bi-trash"></i>
					  </button>
					<% } %>
				  </div>
				</td>
			  </tr>

			  <!-- Delete Modal -->
			  <% if(currentUser.id !== user.id) { %>
				<div class="modal fade" id="deleteModal<%= user.id %>" tabindex="-1">
				  <div class="modal-dialog modal-dialog-centered">
					<div class="modal-content" style="border: none; border-radius: 12px; box-shadow: 0 10px 30px #0002;">
					  <div class="modal-header" style="border-bottom: 1px solid #edf0f1;">
						<h5 class="modal-title" style="font-weight: 700;">
						  <i class="bi bi-exclamation-triangle" style="color: #d74b4b; margin-right: 8px;"></i>Xác nhận xóa tài khoản
						</h5>
						<button type="button" class="btn-close" data-bs-dismiss="modal"></button>
					  </div>
					  <div class="modal-body">
						<p>Bạn có chắc chắn muốn xóa tài khoản <strong><%= user.username %></strong>?</p>
						<div class="hint" style="background: #ffe6e6; color: #c43e3e; border-left: 4px solid #d74b4b;">
						  <i class="bi bi-exclamation-circle"></i> Hành động này không thể hoàn tác.
						</div>
					  </div>
					  <div class="modal-footer" style="border-top: 1px solid #edf0f1;">
						<button type="button" class="btn light-dark" data-bs-dismiss="modal">Hủy</button>
						<form method="POST" action="/admin/users/delete/<%= user.id %>" style="display: inline;">
						  <button type="submit" class="btn dark">
							<i class="bi bi-trash" style="margin-right: 6px;"></i>Xóa tài khoản
						  </button>
						</form>
					  </div>
					</div>
				  </div>
				</div>
			  <% } %>
			<% }); %>
		  </tbody>
		</table>
	  </div>
	</div>
  <% } else { %>
	<div class="panel empty">
	  <i class="bi bi-inbox" style="font-size: 48px; color: #c0cdd4; margin-bottom: 12px;"></i>
	  <h4 style="color: #70818a; margin: 10px 0;">Không có tài khoản nào</h4>
	  <p style="color: #90a0a9; margin: 0;">Các tài khoản sẽ xuất hiện tại đây khi người dùng đăng ký.</p>
	</div>
  <% } %>
</div>

<%- include('../partials/footer') %>
