<%- include('../partials/header') %>

<div class="container-fluid py-4">
  <div class="row">
	<div class="col-lg-8 mx-auto">
	  <!-- Header -->
	  <div class="mb-4">
		<a href="/admin/users" class="btn btn-sm btn-outline-secondary mb-3">
		  <i class="bi bi-chevron-left"></i> Quay lại
		</a>
		<h1 class="mb-2"><i class="bi bi-pencil-square"></i> Chỉnh sửa tài khoản</h1>
		<p class="text-muted">Cập nhật thông tin cá nhân và quản lý quyền truy cập</p>
	  </div>

	  <%- include('../partials/flash') %>

	  <div class="card shadow-sm border-0">
		<div class="card-body p-4">
		  <form method="POST">
			<!-- Username Section -->
			<div class="mb-4 pb-3 border-bottom">
			  <label class="form-label fw-bold"><i class="bi bi-person-badge"></i> Tên đăng nhập</label>
			  <input type="text" class="form-control" value="<%= user.username %>" disabled>
			  <small class="text-muted d-block mt-2">
				<i class="bi bi-info-circle"></i> Tên đăng nhập không thể thay đổi
			  </small>
			</div>

			<!-- Full Name -->
			<div class="mb-4">
			  <label class="form-label fw-bold"><i class="bi bi-person"></i> Tên đầy đủ</label>
			  <input type="text" class="form-control form-control-lg" name="full_name" value="<%= user.full_name %>" required placeholder="Nhập tên đầy đủ">
			</div>

			<!-- Email -->
			<div class="mb-4">
			  <label class="form-label fw-bold"><i class="bi bi-envelope"></i> Email</label>
			  <input type="email" class="form-control form-control-lg" name="email" value="<%= user.email %>" placeholder="Để trống nếu không cần cập nhật">
			  <small class="text-muted d-block mt-2">Email được sử dụng để liên hệ và xác thực</small>
			</div>

			<!-- Role Section -->
			<div class="mb-4 pb-3 border-bottom">
			  <label class="form-label fw-bold"><i class="bi bi-shield-check"></i> Vai trò</label>
			  <select class="form-select form-select-lg" name="role" required>
				<option value="user" <%= user.role === 'user' ? 'selected' : '' %>>
				  <i class="bi bi-person"></i> User (Người dùng thường)
				</option>
				<option value="admin" <%= user.role === 'admin' ? 'selected' : '' %>>
				  <i class="bi bi-shield-check"></i> Admin (Quản trị viên)
				</option>
			  </select>
			  <% if(currentUser.id === user.id) { %>
				<div class="alert alert-warning mt-3 mb-0">
				  <i class="bi bi-exclamation-triangle"></i> 
				  <strong>Cảnh báo:</strong> Bạn không thể tự thay đổi vai trò từ Admin sang User
				</div>
			  <% } %>
			</div>

			<!-- Created At -->
			<div class="mb-4">
			  <label class="form-label fw-bold"><i class="bi bi-calendar"></i> Ngày đăng ký</label>
			  <input type="text" class="form-control" value="<%= user.created_at_display %>" disabled>
			  <small class="text-muted d-block mt-2">Theo giờ Việt Nam (UTC+7)</small>
			</div>

			<!-- Action Buttons -->
			<div class="d-flex gap-2 pt-2">
			  <button type="submit" class="btn btn-primary btn-lg">
				<i class="bi bi-check-circle"></i> Lưu thay đổi
			  </button>
			  <a href="/admin/users" class="btn btn-outline-secondary btn-lg">
				<i class="bi bi-x-circle"></i> Hủy
			  </a>
			</div>
		  </form>
		</div>
	  </div>

	  <!-- User Info Card -->
	  <div class="card card-info mt-4 shadow-sm border-0">
		<div class="card-body">
		  <h6 class="card-title mb-3"><i class="bi bi-info-circle"></i> Thông tin tài khoản</h6>
		  <ul class="list-unstyled small text-muted">
			<li><i class="bi bi-check-circle text-success"></i> ID tài khoản: <strong><%= user.id %></strong></li>
			<li class="mt-2"><i class="bi bi-clock-history"></i> Cập nhật lần cuối: chưa theo dõi</li>
			<li class="mt-2"><i class="bi bi-info-circle"></i> Các thay đổi sẽ có hiệu lực ngay lập tức</li>
		  </ul>
		</div>
	  </div>
	</div>
  </div>
</div>

<style>
  .card {
	border-radius: 10px;
  }
  .card-info {
	background-color: #f0f7ff;
	border-left: 4px solid #0d6efd;
  }
  .form-control, .form-select {
	border-radius: 6px;
	border: 1px solid #dee2e6;
  }
  .form-control:focus, .form-select:focus {
	border-color: #667eea;
	box-shadow: 0 0 0 0.2rem rgba(102, 126, 234, 0.25);
  }
  .form-label {
	color: #333;
  }
  .btn-lg {
	padding: 10px 24px;
	font-weight: 500;
  }
  .alert-warning {
	background-color: #fff3cd;
	border-left: 4px solid #ffc107;
  }
</style>

<%- include('../partials/footer') %>
