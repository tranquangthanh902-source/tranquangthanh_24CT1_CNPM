<%- include('partials/header') %>
<div class="auth-page">
  <div class="auth-card">
    <div class="auth-icon"><i class="fa-solid fa-book-open"></i></div>
    <h1>Đăng nhập</h1>
    <p>Đăng nhập vào hệ thống quản lý thư viện</p>

    <%- include('partials/flash') %>

    <!-- Traditional Login Form -->
    <form method="post" action="/login">
      <label>Tên đăng nhập
        <input name="username" required autocomplete="username">
      </label>
      <label>Mật khẩu
        <input type="password" name="password" required autocomplete="current-password">
      </label>
      <button class="btn primary full">Đăng nhập</button>
    </form>

    <!-- Divider -->
    <div style="display: flex; align-items: center; margin: 20px 0; gap: 10px;">
      <div style="flex: 1; height: 1px; background: #ddd;"></div>
      <span style="color: #999; font-size: 13px;">HOẶC</span>
      <div style="flex: 1; height: 1px; background: #ddd;"></div>
    </div>

    <!-- Google OAuth Login -->
    <a href="/auth/google" class="btn" style="background: #fff; color: #333; border: 1px solid #ddd; width: 100%; margin-bottom: 15px; text-align: center;">
      <i class="fa-brands fa-google" style="margin-right: 8px;"></i> Đăng nhập bằng Gmail
    </a>

    <a href="/register" class="back">Chưa có tài khoản? Đăng ký</a>
    <a href="/" class="back">← Về trang chủ</a>
  </div>
</div>
<%- include('partials/footer') %>
